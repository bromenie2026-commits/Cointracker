# Kopieer naar .env voor lokaal draaien. NOOIT committen.
# In GitHub zet je deze waarden als repository secrets.

# --- e-mail (verplicht voor alerts) ---
GMAIL_ADDRESS=jouwadres@gmail.com
# Gmail app-wachtwoord (16 tekens), NIET je gewone wachtwoord.
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
ALERT_RECIPIENT=jouwadres@gmail.com

# --- Claude narratief-check (staat standaard AAN) ---
ANTHROPIC_API_KEY=sk-ant-...
# Zet op false als je zonder de narratief-check wilt draaien:
# CLAUDE_META_CHECK_ENABLED=false

# --- optioneel ---
# Eigen RPC (Helius/QuickNode) is veel betrouwbaarder dan de publieke.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
RUGCHECK_API_KEY=
X_BEARER_TOKEN=

# --- tuning ---
USD_PER_EUR=1.09
MIN_MARKETCAP_EUR=35000
MAX_CANDIDATES_PER_RUN=40
DEDUP_COOLDOWN_HOURS=6
MIN_SOFT_SCORE_TO_ALERT=55
